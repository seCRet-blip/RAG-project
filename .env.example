# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Qdrant (use existing rag-qdrant container when running)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# vLLM — small local model (~1-2 GB VRAM), port 8002 (8001 may be taken by other stacks)
VLLM_BASE_URL=http://localhost:8002/v1
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Chat UI — port 8788 (8787 is your dashboard)
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=8788

# Embeddings (free, local ONNX via fastembed — no API keys)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# Small local vLLM (2048 context) — keep prompts short
RAG_TOP_K=3
RAG_MAX_CONTEXT_CHARS=2800
RAG_MAX_CHUNK_CHARS=700
RAG_MAX_OUTPUT_TOKENS=160

# Crawler (free — hits public docs only, rate-limited)
CRAWL_MAX_PAGES=100
CRAWL_DELAY_SECONDS=1.0
